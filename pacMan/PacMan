package edu.upb.lp.game.pacMan;

public class PacMan {
	private int direccion = 0; // 0= arriba, 1= derecha, 2= abajo, 3= izquierda
	private int fila = 10;
	private int columna = 15;
	private PacManGame game; 
	private String idDelAvanzador;

	public PacMan(int fila, int columna, PacManGame game) {
		this.fila = fila;
		this.columna = columna;
		this.game = game;
	}

	public int getDireccion() {
		return direccion;
	}

	public int getFila() {
		return fila;
	}

	public int getColumna() {
		return columna;
	}

	public void girarArriba() {
		game.borrarPacman(fila, columna);
		direccion = 0;
		game.dibujarPacman(fila, columna, direccion);
	}

	public void girarAbajo() {
		game.borrarPacman(fila, columna);
		direccion = 2;
		game.dibujarPacman(fila, columna, direccion);
	}

	public void girarDerecha() {
		game.borrarPacman(fila, columna);
		direccion = 1;
		game.dibujarPacman(fila, columna, direccion);
	}

	public void girarIzquierda() {
		game.borrarPacman(fila, columna);
		direccion = 3;
		game.dibujarPacman(fila, columna, direccion);
	}

	public void avanzarPacman() {
		game.borrarPacman(fila, columna);
		if (direccion == 0) {
			if (game.puedoIrAhi(fila-1, columna)) {
				game.borrarPacman(fila, columna);
				fila--;
			}
			direccion = 0;
			game.dibujarPacman(fila, columna, direccion);

		} else if (direccion == 1) {
			if (fila == 8 && columna == 31) {
				game.borrarPacman(fila, columna);
				columna = 0;
			} else if (game.puedoIrAhi(fila, columna+1)) {
				game.borrarPacman(fila, columna);
				columna++;
			}
			direccion = 1;
			game.dibujarPacman(fila, columna, direccion);
		} else if (direccion == 2) {
			if (game.puedoIrAhi(fila+1, columna)) {
				game.borrarPacman(fila, columna);
				fila++;
			}
			direccion = 2;
			game.dibujarPacman(fila, columna, direccion);
		}else if (direccion == 3) {
			if(fila==8 && columna==0) {
				game.borrarPacman(fila, columna);
				columna = 31;
			}else if (game.puedoIrAhi(fila, columna-1)) {
				game.borrarPacman(fila, columna);
				columna--;
			}
			direccion = 3;
			game.dibujarPacman(fila, columna, direccion);
		}
	}
	
	public void comenzarAAvanzar() {
		int tiempo;
	    if (game.isVelocidadAumentada()) {
	        tiempo = 70;  // rapidisimo con piña
	    } else {
	        tiempo = 200; // velocidad normal
	    }
		idDelAvanzador = game.executeRepeatedly(new AvanzadorDePacman(this), tiempo);
	}
	public void actualizarVelocidad() {
	    detenerse();          // Detiene el temporizador actual
	    comenzarAAvanzar();   // Arranca un nuevo temporizador con el nuevo tiempo
	}
	
	public void detenerse() {
		game.stopLoop(idDelAvanzador);
	}
}
