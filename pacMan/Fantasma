package edu.upb.lp.game.pacMan;

import java.util.Random;

public class Fantasma {
	private int fila;
	private int columna;
	private int direccion = 0; // 0= arriba, 1= derecha, 2= abajo, 3= izquierda
	private int color = 0; // 0=rojo, 1=rosa, 2=celeste, 3=naranja
	private PacManGame game;
	private String idDelAvanzadorf;

	private Random rnd = new Random();

	public Fantasma(int fila, int columna, int direccion, int color, PacManGame game) {
		this.fila = fila;
		this.columna = columna;
		this.direccion = direccion;
		this.color = color;
		this.game = game;
	}

	public int getDireccion() {
		return direccion;
	}

	public int getFilas() {
		return fila;
	}

	public int getColumnas() {
		return columna;
	}

	public void dibujar() {
		game.dibujarFantasma(fila, columna, "fantasma_" + color + "_" + direccion);
	}

	public void borrar() {
		game.borrarFantasma(fila, columna);
	}

	public void girar() {
		if (fila == 8 && columna == 31 || fila == 8 && columna == 0) {
			direccion = (direccion + 2) % 4;
		} else {
			int nuevaDireccion;
			do {
				nuevaDireccion = rnd.nextInt(4);
			} while (nuevaDireccion == (direccion + 2) % 4 || !puedoIrEnEstaDireccion(nuevaDireccion));
			direccion = nuevaDireccion;
		}
	}

	public boolean puedoIrEnEstaDireccion(int direccion) {
		if (direccion == 0) {
			return game.puedoIrAhi(fila - 1, columna);
		} else if (direccion == 1) {
			return game.puedoIrAhi(fila, columna + 1);
		} else if (direccion == 2) {
			return game.puedoIrAhi(fila + 1, columna);
		} else if (direccion == 3) {
			return game.puedoIrAhi(fila, columna - 1);
		} else {
			throw new IllegalArgumentException();
		}
	}

	public void avanzarFantasma() {
		game.borrarFantasma(fila, columna);
		if (direccion == 0) {
			if (game.puedoIrAhi(fila - 1, columna)) {
				game.borrarFantasma(fila, columna);
				fila--;
			}
		} else if (direccion == 1) {
			if (fila == 8 && columna == 31) {
				game.borrarFantasma(fila, columna);
				columna = 0;
			} else if (game.puedoIrAhi(fila, columna + 1)) {
				game.borrarFantasma(fila, columna);
				columna++;
			}
		} else if (direccion == 2) {
			if (game.puedoIrAhi(fila + 1, columna)) {
				game.borrarFantasma(fila, columna);
				fila++;
			}
		} else if (direccion == 3) {
			if (fila == 8 && columna == 0) {
				game.borrarFantasma(fila, columna);
				columna = 31;
			} else if (game.puedoIrAhi(fila, columna - 1)) {
				game.borrarFantasma(fila, columna);
				columna--;
			}
		} else {
			throw new IllegalStateException("ValorDeDireccionInvalido");
		}
		girar();
		dibujar();
	}

	public void comenzarMovimiento() {
		idDelAvanzadorf = game.executeRepeatedly(new AvanzadorDeFantasma(this), 125);
	}

	public void dejarDeAvanzar() {
		game.stopLoop(idDelAvanzadorf);
	}
}
