package edu.upb.lp.game.pacMan;

public class Manzana extends Fruta {

	public Manzana(int fila, int columna) {
		super("Manzana", fila, columna);
	}

	@Override
	public void aplicarPoder(PacManGame game) {
		for (int i = 0; i < game.getArrFant().length; i++) {
			game.getArrFant()[i].ralentizar(20); // 20 movimientos lentos
		}
	}
}
