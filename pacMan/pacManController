package edu.upb.lp.game.pacMan;

import edu.upb.lp.game.core.GameController;
import edu.upb.lp.game.core.GameUI;

public class PacManController implements GameController {
    private GameUI libreria;
    private PacManGame game;

    public PacManController(GameUI libreria) {
        this.libreria = libreria;
        this.game = new PacManGame(this);
    }

	@Override
	public void onButtonPressed(String name) {
		if (name.equals("RESTART")) {
	        libreria.removeButton(name);
	        game.reiniciarJuego(); 
	    }
	}

	@Override
	public void onCellPressed(int row, int col) {

	}

	@Override
	public void onCommand(String command) {
		if (command.equals("MoverArriba")) {
			game.girarArriba();
		} else if (command.equals("MoverAbajo")) {
			game.girarAbajo();
		} else if (command.equals("MoverIzquierda")) {
			game.girarIzquierda();
		} else if (command.equals("MoverDerecha")) {
			game.girarDerecha();
		} else if (command.equals("Mover")) {
			game.moverPacman();
		
		}
	}

	@Override
	public void initialiseInterface() {
		libreria.configureGrid(18, 32, 1200, 560, false);

		for (int r = 0; r < 18; r++) {
			for (int c = 0; c < 32; c++) {
				String nombreImagen = "Mapa_r" + (r + 1) + "_c" + (c + 1);
				libreria.setCellBackgroundImage(r, c, nombreImagen);
				if (game.hayPunto(r, c)) {
					libreria.setCellObjectImage(r, c, "puntoPac");
				}
			}
		}
	    actualizarPuntaje(game.getScore());
		// Vincular las teclas del teclado
				libreria.bindKey("W", "MoverArriba");
				libreria.bindKey("S", "MoverAbajo");
				libreria.bindKey("A", "MoverIzquierda");
				libreria.bindKey("D", "MoverDerecha");
				libreria.bindKey("P", "Mover");
				libreria.playSound("Pacman_Introduction");
				
				PacMan p = game.getPacman();
				dibujarPacman(p.getFila(), p.getColumna(), p.getDireccion());
				libreria.executeLater(new StarteadorDeGame(game), 4500);
			}

	public void dibujarVida(int fila, int columna) {
	    libreria.setCellObjectImage(fila, columna, "Vida");
	}
	public void cambiarAVidaVacia(int fila, int columna) {
	    libreria.setCellObjectImage(fila, columna, "Vidavacia"); 
	}
	public void borrarObjeto(int fila, int columna) {
	    libreria.clearCellObjectImage(fila, columna);
	}
	private void actualizarVidas(int vidas) {
		
	}

	public void actualizarPuntaje(int puntaje) {
		libreria.setCellText(17, 10, "S");
	    libreria.setCellText(17, 11, "C");
	    libreria.setCellText(17, 12, "O");
	    libreria.setCellText(17, 13, "R");
	    libreria.setCellText(17, 14, "E");
	    libreria.setCellText(17, 15, ":");
	    
	    libreria.setCellText(17, 17, String.valueOf(puntaje));	}

	public void dibujarPacman(int filas, int columnas, int direccion) {
		String pacmanImg = "pacman_arriba";
		if (direccion == 0) {
			pacmanImg = "pacman_arriba";
		} else if (direccion == 1) {
			pacmanImg = "pacman_derecha";
		} else if (direccion == 2) {
			pacmanImg = "pacman_abajo";
		} else if (direccion == 3) {
			pacmanImg = "pacman_izquierda";
		}
		libreria.setCellObjectImage(filas, columnas, pacmanImg);
	}

	public void borrarPacman(int filas, int columnas) {
		libreria.clearCellObjectImage(filas, columnas);
	}

	public String executeRepeatedly(Runnable r, int ms) {
		return libreria.executeRepeatedly(r, ms);
	}
	
	public void dibujarFruta(int fila, int columna, String nombreFruta) {
	    libreria.setCellObjectImage(fila, columna, nombreFruta);
	}
	public void stopLoop(String id) {
		libreria.stopLoop(id);
	}


	public void borrarFantasma(int fila, int columna) {
		libreria.clearCellObjectImage(fila, columna);
		
	}

	public void dibujarFantasma(int fila, int columna, String imagen) {
		libreria.setCellObjectImage(fila, columna, imagen);
	}
	public void dibujarFantasmaAzul(int fila, int columna, String imagen) {
		libreria.setCellObjectImage(fila, columna, "Fantasma_Azul");
	}

	public void programarFinVelocidad(int duracionMs) {
		libreria.executeLater(new FinalizadorDeVelocidad(game), 4500);
	}
	public void mostrarMensajeTemporal(String mensaje) {
	    libreria.showTemporaryMessage(mensaje);
	}
	public void dibujarPunto(int fila, int columna) {
		libreria.setCellObjectImage(fila, columna, "puntoPac");
	}

	public void mostrarBotonReiniciar() {
	    AccionReiniciar accion = new AccionReiniciar(game);
	    libreria.addButton("RESTART"); 
	}	
	public void mensaje(String mensaje) {
		libreria.showMessage(mensaje);
	}
	public void programarFinFantasmaAzul(int duracionMs) {
	    libreria.executeLater(new FinalizadorDeFantasmaAzul(game), 10000);
	}
	public void programarLiberacionFantasma(int duracionMs) {
	    libreria.executeLater(new LiberadorDeFantasma(game), duracionMs);
	}
}
