	public PacManGame(PacManController controller) {
		this.controller = controller;
		this.pacman = new PacMan(10, 15, this);
		this.listaFrutas = new LinkedList<>();
	}

	// 0 = pared; 1= camino vacio; 2= camino lleno

	public void dibujarPacman(int fila, int columna, int direccion) {
		if (mapa[fila][columna] == 2) {
			mapa[fila][columna] = 1;
			sumarScore(10);
			contadorDePuntos--;
			if (contadorDePuntos == 0) {
				victoria();
			}
		}
		boolean encontrada = false;
		Fruta frutaAComer = null;

		for (int i = 0; i < listaFrutas.size() && !encontrada; i++) {
			Fruta f = listaFrutas.get(i);
			if (f.getFila() == fila && f.getColumna() == columna) {
				frutaAComer = f;
				encontrada = true;
			}
		}

		if (frutaAComer != null) {
			recolectarFruta(frutaAComer);
		}
		controller.dibujarPacman(fila, columna, direccion);
		dibujarFrutas();
	}

	private void victoria() {
		pacman.detenerse();
		for (int i = 0; i < getArrFant().length; i++) {
			getArrFant()[i].dejarDeAvanzar();
		}
		stopLoop(loopFrutasId);
		for (int i = 0; i < listaFrutas.size(); i++) {
	        Fruta f = listaFrutas.get(i);
	        controller.borrarPacman(f.getFila(), f.getColumna());
	    }
		if (isVelocidadAumentada()) {
	        desactivarVelocidad();
	    }
		controller.mostrarBotonReiniciar();
	    showTemporaryMessage("¡Felicidades! ¡Has ganado!");
	}

	public void borrarPacman(int filas, int columnas) {
