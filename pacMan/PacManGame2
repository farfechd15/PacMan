	public void setValor(int fila, int columna, int valor) {
		this.mapa[fila][columna] = valor;
	}

	public boolean hayPunto(int r, int c) {
		return mapa[r][c] == 2;
	}

	public void stopLoop(String id) {
		controller.stopLoop(id);
	}

	public List<Fruta> getListaFrutas() {
		return listaFrutas;
	}

	private void inicializarFantasmas() {
		for (int i = 0; i < 4; i++) {
			arrFant[i] = new Fantasma(8, 14 + i, 0, i, this);
			arrFant[i].dibujar();
			arrFant[i].comenzarMovimiento();
		}
	}

	public void borrarFantasma(int fila, int columna) {
		if (hayPunto(fila, columna)) {
			controller.dibujarPunto(fila,columna);
		} else {
			controller.borrarFantasma(fila, columna);
		}

	}

	public void dibujarFantasma(int fila, int columna, String imagen) {
		controller.dibujarFantasma(fila, columna, imagen);

	}

