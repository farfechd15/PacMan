	public void verificarColision() {
		for (int i = 0; i < getArrFant().length; i++) {
			if (getArrFant()[i] != null) {
				int ff = getArrFant()[i].getFila();
				int fc = getArrFant()[i].getColumna();

				if (pacman.getFila() == ff && pacman.getColumna() == fc) {
					gameOver();
				}
			}
		}
	}
public Fantasma[] getArrFant() {
		return arrFant;
	}

	public void reiniciarJuego() {
		pacman.detenerse();
		borrarPacman(pacman.getFila(), pacman.getColumna());
		for (int i = 0; i < arrFant.length; i++) {
			arrFant[i].dejarDeAvanzar();
			arrFant[i].borrar();
		}
		stopLoop(loopFrutasId);
		
		for (int i = 0; i < listaFrutas.size(); i++) {
	        Fruta f = listaFrutas.get(i);
	        controller.borrarPacman(f.getFila(), f.getColumna()); // Borra la imagen de la fruta
	    }
		
		this.listaFrutas = new LinkedList<>();
		this.score = 0;
		this.contadorDePuntos = 338;
		this.vidas=1;
		controller.actualizarPuntaje(this.score);

		dibujarVidasIniciales();
		
		for (int r = 0; r < filas; r++) {
			for (int c = 0; c < columnas; c++) {
				boolean esZonaCasaFantasmas = (r == 6 || r == 7) && (c >= 13 && c <= 18);
				if (mapa[r][c] == 1 && !esZonaCasaFantasmas) { // Lo que era camino vacio vuelve a tener punto
					mapa[r][c] = 2;
					controller.dibujarPunto(r, c); // Vuelve a pintar el punto amarillo
				}
			}
		}
		generarFrutaAleatoria();

		this.pacman = new PacMan(10, 15, this);
		this.arrFant = new Fantasma[4];
		this.arrFant[0] = new Fantasma(8, 14, 0, 0, this); // Rojo
		this.arrFant[1] = new Fantasma(8, 15, 1, 1, this); // Rosa
		this.arrFant[2] = new Fantasma(8, 16, 2, 2, this); // Celeste
		this.arrFant[3] = new Fantasma(8, 17, 3, 3, this); // Naranja
		dibujarPacman(pacman.getFila(), pacman.getColumna(), pacman.getDireccion());
		for (int i = 0; i < arrFant.length; i++) {
			arrFant[i].dibujar();
		}
		pacman.comenzarAAvanzar();
		for (int i = 0; i < arrFant.length; i++) {
			arrFant[i].comenzarMovimiento();
		}
		this.loopFrutasId = executeRepeatedly(new ActualizadorDeFrutaPorTiempo(this), 4500);
	}
	private void gameOver() {
		perderVida();
		pacman.detenerse();

		for (int i = 0; i < getArrFant().length; i++) {
			if (getArrFant()[i] != null) {
				getArrFant()[i].dejarDeAvanzar();
			}
		}
		stopLoop(loopFrutasId);
		dibujarPacman(pacman.getFila(), pacman.getColumna(), pacman.getDireccion());
		controller.mostrarBotonReiniciar();
		controller.mensaje("GAME OVER");
	}
